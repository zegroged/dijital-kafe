# KAFE ortam değişkenleri şablonu. Kopyala:  cp .env.example .env
NODE_ENV=development

# --- Zorunlu çekirdek ---
DATABASE_URL="postgresql://kafe:kafe_dev_pw@localhost:5432/kafe?schema=public"
REDIS_URL="redis://localhost:6379"
# Üret:  npx auth secret   (veya: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# --- Subdomain kök domaini ---
NEXT_PUBLIC_ROOT_DOMAIN="localhost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Resend (e-posta) — opsiyonel ---
RESEND_API_KEY=""
EMAIL_FROM="KAFE <onboarding@to-p1.com>"

# --- BunnyCDN (depolama) — opsiyonel ---
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_HOST="storage.bunnycdn.com"
BUNNY_CDN_URL="https://p1.b-cdn.net"

# --- AR Code (3D/AR) — opsiyonel ---
# stub | mock | live
ARCODE_PROVIDER="stub"
ARCODE_API_KEY=""
ARCODE_API_BASE=""
ARCODE_WEBHOOK_SECRET=""

# --- İç servis çağrıları ---
INTERNAL_API_KEY=""

# =========================================================
# ŞİRKET / SATICI BİLGİLERİ (yasal sayfalar + schema.org)
# =========================================================
# Boş bırakılırsa yasal sayfalar "[...]" yer tutucusu gösterir ve
# companyConfigured() false döner. Üretimde doldurulmalıdır.
COMPANY_TRADE_NAME="Dijital Kafe"
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_TRADE_REGISTRY_NO=
COMPANY_PHONE=
COMPANY_EMAIL="info@dijitalkafe.com"
COMPANY_WEBSITE="https://dijitalkafe.com"

# --- Platform iç ekonomisi (oran, 0-1 arası; boşsa 0 = pay alınmaz) ---
QR_PLATFORM_FEE_RATE=
AFFILIATE_RATE_ONE_TIME=
AFFILIATE_RATE_RECURRING=
